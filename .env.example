# Newsletter (Resend). Set these in Vercel → Project → Settings → Environment Variables.
# Until all three exist, /api/subscribe answers 503 and the signup block shows its
# "form is broken" state instead of silently dropping addresses.

# From your Resend dashboard → API Keys. Needs sending + contacts permission.
RESEND_API_KEY=

# Resend → Audiences → the audience subscribers should land in (a UUID).
RESEND_AUDIENCE_ID=

# Any long random string. Signs the confirmation links, so changing it
# invalidates links already in flight. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEWSLETTER_SECRET=

# Optional. Must be on a domain verified in that Resend account.
# Defaults to "Avi <hello@nexprove.com>".
NEWSLETTER_FROM=
